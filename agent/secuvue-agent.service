[Unit]
Description=SecuView Monitoring Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/secuvue-agent
EnvironmentFile=/etc/secuvue-agent.env
ExecStart=/usr/bin/python3 /opt/secuvue-agent/agent.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
